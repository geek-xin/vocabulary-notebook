{
  // 应用级配置。字段名依据华为官方文档《app.json5 配置文件》。
  //
  // ⚠️ versionCode / versionName 的**写法是脚本契约，改动会导致 CI 静默失配**：
  //    scripts/set-version.mjs 用的正则是
  //      /versionCode:\s*\d+/  和  /versionName:\s*"[^"]*"/
  //    冒号必须**紧跟 key**，所以这两个 key **不能加引号**（写成 "versionCode": 会失配），
  //    值必须是裸数字 / 双引号字符串。JSON5 允许无引号 key，DevEco 也接受这种写法。
  app: {
    bundleName: "com.geekxin.vocabularynotebook",
    vendor: "geekxin",
    versionCode: 20260930,
    versionName: "2026.09.30.1",
    icon: "$media:app_icon",
    label: "$string:app_name",
  },
}
